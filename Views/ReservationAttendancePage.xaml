<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AppMobile.ViewModels"
             xmlns:models="clr-namespace:AppMobile.Models"
             x:Class="AppMobile.Views.ReservationAttendancePage"
             x:DataType="vm:ReservationAttendanceViewModel"
             BackgroundColor="#f3f4f6"
             Title="">

    <Grid RowDefinitions="Auto,Auto,Auto,*">

        <!-- En-tête -->
        <Frame Grid.Row="0" BackgroundColor="#0d9488" CornerRadius="0" Padding="20,16" HasShadow="False">
            <Grid ColumnDefinitions="*,44">
                <VerticalStackLayout Spacing="4" VerticalOptions="Center">
                    <Label Text="{Binding RoomName}" FontSize="18" FontAttributes="Bold" TextColor="White"
                           LineBreakMode="TailTruncation"/>
                    <Label Text="{Binding TimeRange}" FontSize="13" TextColor="#ccfbf1"/>
                    <Label Text="{Binding ClassName}" FontSize="12" TextColor="#99f6e4"
                           IsVisible="{Binding ClassName, Converter={StaticResource IsNotEmptyConverter}}"/>
                </VerticalStackLayout>
                <Button Grid.Column="1" Text="✕" Command="{Binding CloseCommand}"
                        BackgroundColor="Transparent" TextColor="White"
                        FontSize="20" FontAttributes="Bold"
                        WidthRequest="44" HeightRequest="44" Padding="0" VerticalOptions="Center"/>
            </Grid>
        </Frame>

        <!-- Message succès -->
        <Frame Grid.Row="1"
               IsVisible="{Binding SuccessMessage, Converter={StaticResource IsNotEmptyConverter}}"
               BackgroundColor="#dcfce7" CornerRadius="0" Padding="16,10" HasShadow="False">
            <Label Text="{Binding SuccessMessage}" TextColor="#16a34a" FontSize="13"/>
        </Frame>

        <!-- Message erreur -->
        <Frame Grid.Row="2"
               IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotEmptyConverter}}"
               BackgroundColor="#fee2e2" CornerRadius="0" Padding="16,10" HasShadow="False">
            <Label Text="{Binding ErrorMessage}" TextColor="#dc2626" FontSize="13"/>
        </Frame>

        <!-- Liste des élèves -->
        <CollectionView Grid.Row="3" ItemsSource="{Binding Students}" Margin="16,12">
            <CollectionView.EmptyView>
                <Label Text="Aucun élève pour cette réservation." TextColor="#94a3b8"
                       FontSize="14" HorizontalOptions="Center" Margin="0,40,0,0"/>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:ReservationStudent">
                    <Frame Margin="0,0,0,10" Padding="14,12" CornerRadius="12"
                           BackgroundColor="White" HasShadow="False">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" VerticalOptions="Center">

                            <!-- Nom + badges -->
                            <VerticalStackLayout Grid.Column="0" Spacing="5" VerticalOptions="Center">
                                <Label Text="{Binding FullName}" FontSize="15"
                                       FontAttributes="Bold" TextColor="#1e293b"/>

                                <Frame IsVisible="{Binding IsLate}"
                                       BackgroundColor="#fef3c7" CornerRadius="6"
                                       Padding="8,3" HasShadow="False" HorizontalOptions="Start">
                                    <Label FontSize="12" FontAttributes="Bold" TextColor="#92400e">
                                        <Label.Text>
                                            <MultiBinding StringFormat="Retard {0}">
                                                <Binding Path="DelayDisplay"/>
                                            </MultiBinding>
                                        </Label.Text>
                                    </Label>
                                </Frame>

                                <Frame IsVisible="{Binding IsAbsentOnly}"
                                       BackgroundColor="#fee2e2" CornerRadius="6"
                                       Padding="8,3" HasShadow="False" HorizontalOptions="Start">
                                    <Label Text="Absent" TextColor="#991b1b"
                                           FontSize="12" FontAttributes="Bold"/>
                                </Frame>
                            </VerticalStackLayout>

                            <!-- Boutons + Retard / + Absent (état vide) -->
                            <HorizontalStackLayout Grid.Column="1"
                                                   IsVisible="{Binding NoRecord}"
                                                   Spacing="8" VerticalOptions="Center">
                                <Button Text="+ Retard"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.MarkLateCommand}"
                                        CommandParameter="{Binding .}"
                                        BackgroundColor="#f59e0b" TextColor="White"
                                        CornerRadius="8" FontSize="12"
                                        HeightRequest="38" Padding="10,0"/>
                                <Button Text="+ Absent"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.MarkAbsentCommand}"
                                        CommandParameter="{Binding .}"
                                        BackgroundColor="#ef4444" TextColor="White"
                                        CornerRadius="8" FontSize="12"
                                        HeightRequest="38" Padding="10,0"/>
                            </HorizontalStackLayout>

                            <!-- Bouton Modifier (état enregistré) -->
                            <Button Grid.Column="1"
                                    IsVisible="{Binding HasRecord}"
                                    Text="✏"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.EditCommand}"
                                    CommandParameter="{Binding .}"
                                    BackgroundColor="#0d9488" TextColor="White"
                                    CornerRadius="8" FontSize="16"
                                    HeightRequest="38" WidthRequest="44"
                                    VerticalOptions="Center"/>
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <ActivityIndicator Grid.Row="3" IsRunning="{Binding IsLoading}"
                           IsVisible="{Binding IsLoading}"
                           Color="#0d9488" HorizontalOptions="Center" VerticalOptions="Center"/>
    </Grid>
</ContentPage>
