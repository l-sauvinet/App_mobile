<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AppMobile.ViewModels"
             xmlns:models="clr-namespace:AppMobile.Models"
             x:Class="AppMobile.Views.CoursesPage"
             x:DataType="vm:CoursesViewModel"
             BackgroundColor="#f1f5f9"
             Title="Mes Cours">

    <Shell.TitleView>
        <Grid ColumnDefinitions="*,Auto" Padding="0,0,8,0">
            <Label Text="{Binding WelcomeMessage}" TextColor="White"
                   FontAttributes="Bold" FontSize="16" VerticalOptions="Center"/>
            <Button Grid.Column="1" Text="Déconnexion" Command="{Binding LogoutCommand}"
                    BackgroundColor="Transparent" TextColor="#94a3b8" FontSize="13"/>
        </Grid>
    </Shell.TitleView>

    <Grid RowDefinitions="Auto,*">

        <!-- ─── Calendrier ─── -->
        <Grid Grid.Row="0" BackgroundColor="#1e2d40" Padding="0,0,0,20">
            <VerticalStackLayout Spacing="0">

                <!-- Navigation mois -->
                <Grid ColumnDefinitions="48,*,48" Padding="4,12,4,4">
                    <Button Grid.Column="0" Text="‹" FontSize="24" TextColor="White"
                            BackgroundColor="Transparent" Command="{Binding PreviousWeekCommand}"
                            HeightRequest="44" WidthRequest="44" Padding="0"/>
                    <Label Grid.Column="1" Text="{Binding MonthYearLabel}"
                           FontSize="18" FontAttributes="Bold" TextColor="White"
                           HorizontalOptions="Center" VerticalOptions="Center"/>
                    <Button Grid.Column="2" Text="›" FontSize="24" TextColor="White"
                            BackgroundColor="Transparent" Command="{Binding NextWeekCommand}"
                            HeightRequest="44" WidthRequest="44" Padding="0"/>
                </Grid>

                <!-- Bande des 7 jours -->
                <CollectionView ItemsSource="{Binding WeekDays}"
                                ItemsLayout="HorizontalList"
                                HeightRequest="80"
                                HorizontalOptions="Center">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:CalendarDay">
                            <Grid WidthRequest="48" HeightRequest="80">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SelectDayCommand}"
                                        CommandParameter="{Binding .}"/>
                                </Grid.GestureRecognizers>
                                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="4">

                                    <!-- Abréviation du jour -->
                                    <Label Text="{Binding ShortDay}" FontSize="10" FontAttributes="Bold"
                                           TextColor="#64748b" HorizontalOptions="Center">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="TextColor" Value="#93c5fd"/>
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>

                                    <!-- Cercle avec numéro -->
                                    <Border WidthRequest="38" HeightRequest="38" StrokeThickness="0"
                                            BackgroundColor="Transparent" HorizontalOptions="Center">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="19"/>
                                        </Border.StrokeShape>
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="BackgroundColor" Value="White"/>
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <Label Text="{Binding DayNumber}" FontSize="16" TextColor="#cbd5e1"
                                               HorizontalOptions="Center" VerticalOptions="Center">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="TextColor" Value="#1e2d40"/>
                                                    <Setter Property="FontAttributes" Value="Bold"/>
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </Border>

                                    <!-- Point "aujourd'hui" -->
                                    <BoxView WidthRequest="5" HeightRequest="5" CornerRadius="3"
                                             HorizontalOptions="Center" Color="Transparent">
                                        <BoxView.Triggers>
                                            <DataTrigger TargetType="BoxView" Binding="{Binding IsToday}" Value="True">
                                                <Setter Property="Color" Value="#60a5fa"/>
                                            </DataTrigger>
                                        </BoxView.Triggers>
                                    </BoxView>

                                </VerticalStackLayout>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </Grid>

        <!-- ─── Cours du jour ─── -->
        <Grid Grid.Row="1" RowDefinitions="Auto,*">

            <!-- En-tête jour sélectionné -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Padding="20,16,20,8">
                <Label Grid.Column="0" Text="{Binding SelectedDayLabel}"
                       FontSize="18" FontAttributes="Bold" TextColor="#1e293b"/>
                <Border Grid.Column="1" StrokeThickness="0" Padding="10,5" VerticalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10"/>
                    </Border.StrokeShape>
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding DaySummaryLabel}" Value="Aucun cours">
                            <Setter Property="BackgroundColor" Value="#f1f5f9"/>
                        </DataTrigger>
                    </Border.Triggers>
                    <Border.BackgroundColor>#e0e7ff</Border.BackgroundColor>
                    <Label Text="{Binding DaySummaryLabel}" FontSize="12"
                           FontAttributes="Bold" TextColor="#4f46e5">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding DaySummaryLabel}" Value="Aucun cours">
                                <Setter Property="TextColor" Value="#94a3b8"/>
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </Border>
            </Grid>

            <!-- Liste des cours et réservations -->
            <RefreshView Grid.Row="1" Command="{Binding LoadCoursesCommand}"
                         IsRefreshing="{Binding IsLoading}" RefreshColor="#263040">
                <ScrollView>
                    <VerticalStackLayout Margin="0,4,0,16" Spacing="0">

                        <!-- État vide -->
                        <VerticalStackLayout IsVisible="{Binding IsEmpty}"
                                             HorizontalOptions="Center" Spacing="8" Margin="0,80,0,0">
                            <Label Text="Pas de cours ce jour" TextColor="#94a3b8"
                                   FontSize="15" HorizontalOptions="Center"/>
                            <Label Text="Tirez vers le bas pour actualiser"
                                   TextColor="#cbd5e1" FontSize="12" HorizontalOptions="Center"/>
                        </VerticalStackLayout>

                        <!-- Cours -->
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding CoursesForDay}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:Course">
                                    <Border Margin="16,0,16,12" BackgroundColor="White" StrokeThickness="0">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="14"/>
                                        </Border.StrokeShape>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SelectCourseCommand}"
                                                CommandParameter="{Binding .}"/>
                                        </Border.GestureRecognizers>
                                        <Grid ColumnDefinitions="5,*,Auto" ColumnSpacing="0">
                                            <BoxView Grid.Column="0" BackgroundColor="#263040" CornerRadius="7"/>
                                            <VerticalStackLayout Grid.Column="1" Padding="14,14,8,14" Spacing="5">
                                                <Label Text="{Binding Display}" FontSize="15" FontAttributes="Bold"
                                                       TextColor="#1e293b" LineBreakMode="TailTruncation"/>
                                                <Label Text="{Binding RoomName}" FontSize="13" TextColor="#64748b"/>
                                            </VerticalStackLayout>
                                            <VerticalStackLayout Grid.Column="2" Padding="0,14,14,14"
                                                                 VerticalOptions="Center" Spacing="4">
                                                <Border StrokeThickness="0" Padding="8,4"
                                                        BackgroundColor="#eff6ff" HorizontalOptions="End">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="8"/>
                                                    </Border.StrokeShape>
                                                    <Label Text="{Binding StartHour}" FontSize="13"
                                                           FontAttributes="Bold" TextColor="#2563eb"/>
                                                </Border>
                                                <Label Text="{Binding Duration}" FontSize="12"
                                                       TextColor="#94a3b8" HorizontalOptions="Center"/>
                                            </VerticalStackLayout>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <!-- Réservations de salle -->
                        <VerticalStackLayout IsVisible="{Binding HasReservationsForDay}">
                            <Label Text="Réservations" FontSize="13" FontAttributes="Bold"
                                   TextColor="#64748b" Margin="20,4,20,8"/>
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding ReservationsForDay}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:RoomReservation">
                                        <Border Margin="16,0,16,12" BackgroundColor="White" StrokeThickness="0">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="14"/>
                                            </Border.StrokeShape>
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SelectReservationCommand}"
                                                    CommandParameter="{Binding .}"/>
                                            </Border.GestureRecognizers>
                                            <Grid ColumnDefinitions="5,*,Auto" ColumnSpacing="0">
                                                <BoxView Grid.Column="0" BackgroundColor="#0d9488" CornerRadius="7"/>
                                                <VerticalStackLayout Grid.Column="1" Padding="14,14,8,14" Spacing="5">
                                                    <Label Text="{Binding RoomName}" FontSize="15" FontAttributes="Bold"
                                                           TextColor="#1e293b" LineBreakMode="TailTruncation"/>
                                                    <Label Text="{Binding ClassName}" FontSize="12" TextColor="#0d9488"
                                                           IsVisible="{Binding ClassName, Converter={StaticResource IsNotEmptyConverter}}"/>
                                                    <Label Text="{Binding Reason}" FontSize="13" TextColor="#64748b"
                                                           IsVisible="{Binding Reason, Converter={StaticResource IsNotEmptyConverter}}"/>
                                                </VerticalStackLayout>
                                                <VerticalStackLayout Grid.Column="2" Padding="0,14,14,14"
                                                                     VerticalOptions="Center" Spacing="4">
                                                    <Border StrokeThickness="0" Padding="8,4"
                                                            BackgroundColor="#ccfbf1" HorizontalOptions="End">
                                                        <Border.StrokeShape>
                                                            <RoundRectangle CornerRadius="8"/>
                                                        </Border.StrokeShape>
                                                        <Label Text="{Binding StartHour}" FontSize="13"
                                                               FontAttributes="Bold" TextColor="#0d9488"/>
                                                    </Border>
                                                    <Label Text="{Binding Duration}" FontSize="12"
                                                           TextColor="#94a3b8" HorizontalOptions="Center"/>
                                                </VerticalStackLayout>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </ScrollView>
            </RefreshView>

            <!-- Loader -->
            <ActivityIndicator Grid.Row="1" IsRunning="{Binding IsLoading}"
                               IsVisible="{Binding IsLoading}"
                               Color="#263040" HorizontalOptions="Center" VerticalOptions="Center"/>
        </Grid>

    </Grid>
</ContentPage>
