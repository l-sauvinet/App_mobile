<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AppMobile.ViewModels"
             x:Class="AppMobile.Views.LoginPage"
             x:DataType="vm:LoginViewModel"
             BackgroundColor="#263040"
             Shell.NavBarIsVisible="False">

    <Grid VerticalOptions="Fill" HorizontalOptions="Fill">

        <!-- Carte centrale -->
        <Frame BackgroundColor="#f1f3f6"
               CornerRadius="20"
               Padding="32,36"
               HasShadow="False"
               WidthRequest="340"
               VerticalOptions="Center"
               HorizontalOptions="Center">

            <VerticalStackLayout Spacing="20" HorizontalOptions="Fill">

                <!-- Logo -->
                <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                    <Frame WidthRequest="90" HeightRequest="90"
                           CornerRadius="18"
                           BackgroundColor="#263040"
                           Padding="14"
                           HasShadow="False"
                           HorizontalOptions="Center">
                        <Image Source="logo_app.svg"
                               WidthRequest="62" HeightRequest="62"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
                    </Frame>
                    <Label Text="Connectez-vous"
                           FontSize="15"
                           FontAttributes="Bold"
                           TextColor="#263040"
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>

                <!-- Message d'erreur -->
                <Frame IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotEmptyConverter}}"
                       BackgroundColor="#fee2e2"
                       CornerRadius="8"
                       Padding="12"
                       HasShadow="False">
                    <Label Text="{Binding ErrorMessage}"
                           TextColor="#dc2626"
                           FontSize="13"/>
                </Frame>

                <!-- Identifiant -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="Identifiant"
                           FontSize="13"
                           TextColor="#475569"
                           FontAttributes="Bold"/>
                    <Frame Padding="0"
                           CornerRadius="10"
                           HasShadow="False"
                           BorderColor="#e2e8f0"
                           BackgroundColor="White">
                        <Entry Text="{Binding Login}"
                               Placeholder="Entrez votre identifiant"
                               TextColor="#1e293b"
                               PlaceholderColor="#94a3b8"
                               ReturnType="Next"
                               BackgroundColor="Transparent"
                               Margin="8,0"/>
                    </Frame>
                </VerticalStackLayout>

                <!-- Mot de passe -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="Mot de passe"
                           FontSize="13"
                           TextColor="#475569"
                           FontAttributes="Bold"/>
                    <Frame Padding="0"
                           CornerRadius="10"
                           HasShadow="False"
                           BorderColor="#e2e8f0"
                           BackgroundColor="White">
                        <Grid ColumnDefinitions="*,44">
                            <Entry Grid.Column="0"
                                   Text="{Binding Password}"
                                   Placeholder="Entrez votre mot de passe"
                                   TextColor="#1e293b"
                                   PlaceholderColor="#94a3b8"
                                   IsPassword="{Binding IsPasswordVisible, Converter={StaticResource InverseBoolConverter}}"
                                   ReturnType="Done"
                                   ReturnCommand="{Binding LoginCommand}"
                                   BackgroundColor="Transparent"
                                   Margin="8,0"/>
                            <ImageButton Grid.Column="1"
                                         Source="{Binding EyeIcon}"
                                         Command="{Binding TogglePasswordCommand}"
                                         BackgroundColor="Transparent"
                                         WidthRequest="20" HeightRequest="20"
                                         VerticalOptions="Center"
                                         HorizontalOptions="Center"
                                         Padding="10"/>
                        </Grid>
                    </Frame>
                </VerticalStackLayout>

                <!-- Bouton connexion -->
                <Button Text="Se connecter"
                        Command="{Binding LoginCommand}"
                        BackgroundColor="#263040"
                        TextColor="White"
                        CornerRadius="10"
                        HeightRequest="50"
                        FontAttributes="Bold"
                        FontSize="15"
                        IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}"
                        Margin="0,4,0,0"/>

                <ActivityIndicator IsRunning="{Binding IsLoading}"
                                   IsVisible="{Binding IsLoading}"
                                   Color="#263040"
                                   HorizontalOptions="Center"/>
            </VerticalStackLayout>
        </Frame>

    </Grid>

</ContentPage>